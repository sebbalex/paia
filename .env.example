# Anthropic auth -- pick exactly ONE of the two.
#
# (a) Subscription. Run `claude setup-token` and paste the sk-ant-oat... value
#     here. Billed against your Claude plan rather than per token.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#
# (b) Metered API billing. A key from console.anthropic.com, sk-ant-api...
# ANTHROPIC_API_KEY=sk-ant-api03-...
#
# These are different credential types and are NOT interchangeable: an
# sk-ant-oat token placed in ANTHROPIC_API_KEY fails with a bare
# "401 API key is invalid". ANTHROPIC_API_KEY also takes precedence when both
# are set, so a stale one silently shadows a working token.
#
# (c) No Claude at all: any model on OpenRouter that does tool calling. Set
#     this INSTEAD of both above, and put an OpenRouter slug in
#     ASSISTANT_MODEL (vendor/model-name). Runs assistant/openrouter.py: same
#     tools, same policy gate, no claude-mem. Pick a model that is strong at
#     tool use -- a weak one follows ROT.md loosely.
# OPENROUTER_API_KEY=sk-or-v1-...
# ASSISTANT_MODEL=vendor/model-name
# What WebSearch asks (a model that searches the web). Empty: no WebSearch.
# OPENROUTER_SEARCH_MODEL=perplexity/sonar
# 0 for a model that takes no image input: photos are then refused politely
# instead of failing the whole request.
# OPENROUTER_IMAGES=1

# Telegram: create bot via @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Your numeric Telegram user id (get from @userinfobot). Comma-separated if several.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Voice notes (local transcription, no external service)
# tiny | base | small | medium | large-v3 -- "small" is the default and holds
# up well for Italian on CPU. "medium" wants more than 4 GB of RAM.
# WHISPER_MODEL=small
# Leave empty to detect the language automatically; "it" forces Italian.
# WHISPER_LANGUAGE=

# Mail for routines that deliver by email (optional).
# Without these, channel: email falls back to Telegram rather than losing the
# result.
# Routines with `channel: email` go to this one address, sent through the
# gws CLI as the Google account it is logged in as (needs gmail.modify or
# gmail.send). SMTP below is only the fallback when MAIL_TO is unset.
MAIL_TO=owner@example.com

# Ceiling on one routine run, in seconds (chat turns stay at 300).
# ROUTINE_TIMEOUT_SECONDS=900

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=owner@example.com
# SMTP_PASSWORD=            # app password, not the account one
# SMTP_FROM=owner@example.com
# SMTP_TO=owner@example.com
# SMTP_TLS=1                # 0 for direct SMTPS on 465

# Google Workspace (calendar reads). The `gws` CLI from
# @googleworkspace/cli, authenticated once with `gws auth setup` and
# `gws auth login` as the user this process runs as. A bare name resolves
# through PATH, which is fine under a login shell and not under systemd:
# put the absolute path here on the server (`command -v gws` to find it).
# Empty disables the calendar tools instead of failing once a morning.
# GWS_BIN=/opt/homebrew/bin/gws

# Which Drive folders the assistant may read: folder ids, comma-separated.
# Every folder beneath one listed here is included, so name the top of each
# tree and nothing else. Everything outside is not searched and cannot be
# read, whatever file id turns up in a mail or a document.
# The id is the last part of the folder URL:
# https://drive.google.com/drive/folders/1AbCdEf_GhIjK  ->  1AbCdEf_GhIjK
# Empty means the whole Drive. That is the old behaviour, not a safe default.
# DRIVE_ALLOWED_FOLDERS=1AbCdEf_GhIjK,1LmNoPq_RsTuV

# The folders Google Docs may be written in, one id or a comma-separated list.
# drive_create_doc puts a trip write-up in one of them; drive_append_doc adds
# to the end of a Doc already in one of them or in any folder beneath one --
# what the trip learned afterwards, and a trip usually has a folder of its own.
# Nothing else at Drive: no replacing, no deleting, no sharing, no changing a
# line that is already written, and a title already in the folder is refused
# rather than duplicated. With more than one listed the model picks which by
# id, and only from this list -- any other id is refused. Each must also appear
# in DRIVE_ALLOWED_FOLDERS above, or the assistant cannot read back what it
# wrote. Empty -- the default -- means it writes nothing at Drive at all.
#
# Appending needs the Docs API switched on in the same Google Cloud project as
# the rest (docs.googleapis.com); creating does not. Without it every append
# comes back as a 403 naming the API.
# DRIVE_WRITE_FOLDERS=1AbCdEf_GhIjK,1LmNoPq_RsTuV

# Which skills are live, by name, comma-separated. A skill in
# .claude/skills/ that is not named here is invisible to the assistant and
# refused if it names it anyway: this list is how a skill gets enabled, the
# same way `enabled: false` is how a routine does. Empty means no skills at
# all, which also keeps the ~25 the claude-mem plugin ships out of the
# listing.
ASSISTANT_SKILLS=price-hunt,adventure-log,trip-design

# -- the scraper worker -------------------------------------------------
# Where scraper/ is listening. This is what makes a price a *verified* price
# rather than a number off a search snippet: the built-in WebFetch is a plain
# GET with a Python TLS fingerprint, and memory/wiki/price-sources.md is the
# record of what that gets you -- two thirds of the shops worth watching
# refusing it. The worker climbs from a Chrome-fingerprinted request, to a
# headless browser, to a real one, to a real one driven through /dev/uinput,
# and stops at the first tier that opens the page.
#
# Empty -- the default -- means the three page tools are not offered at all and
# price hunting falls back to search, exactly as it worked before the worker
# existed. Nothing breaks; the answers are just weaker.
#
# Under the Home Assistant add-on this is the other add-on's container name:
#   SCRAPER_URL=http://addon_sebbalex_paia-scraper:8099
# On a VPS with the systemd unit it is loopback:
#   SCRAPER_URL=http://127.0.0.1:8099
# SCRAPER_URL=

# Shared secret between the assistant and the worker. Not the security
# boundary -- the worker binding to loopback, and having no published port, is
# -- but it stops another process on the same host using it by accident.
# Generate one, do not choose one:  openssl rand -hex 32
# SCRAPER_TOKEN=

# Read by the worker process only (see deploy/paia-scraper.service).
# SCRAPER_STATE=/opt/paia/state/scraper
# How many broken selectors a day the worker may ask the model to repair. The
# failure mode of an auto-healing system is healing the same thing forty times
# an hour while the real problem is elsewhere. 0 disables repair entirely.
# SCRAPER_REPAIR_BUDGET=20
# Force tier 3's GL backend: egl for the Pi's V3D through /dev/dri, angle for
# software rendering. Empty probes for /dev/dri and picks.
# SCRAPER_GL=
# Seconds a browser tier keeps the window open on an anti-bot interstitial
# (Cloudflare "Just a moment...") waiting for it to clear. Closing earlier is
# what turned challenges being passed into 403s. Per domain, a recipe's
# challenge_wait_seconds overrides it.
# SCRAPER_CHALLENGE_WAIT=25

# Intervals.icu, the cycling coach's data (assistant/intervals.py). Both from
# Intervals.icu > Settings > Developer Settings. Either empty and the six
# coach tools are not offered. Activities synced from Strava are hidden by the
# API: connect Garmin to Intervals.icu directly.
# INTERVALS_API_KEY=
# INTERVALS_ATHLETE_ID=
# The day a new watch took over overnight HRV, YYYY-MM-DD. HRV and RHR
# baselines start here; Apple SDNN and Garmin rMSSD do not compare.
# HRV_CUTOVER_DATE=

# Who the assistant serves, and the language they read. IDENTITY.md and
# ROT.md say "the owner"; these make it a person.
OWNER_NAME=
OWNER_LANGUAGE=English

# Optional overrides
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_ROOT=/opt/paia
